{
  "name": "resq",
  "version": "1.0.0",
  "description": "Advanced Search and Rescue Resource Allocation System",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "tsx watch server/index.ts",
    "client:dev": "vite",
    "build": "tsc && vite build",
    "server:build": "tsc -p tsconfig.server.json",
    "db:migrate": "node --loader tsx scripts/migrate.ts",
    "db:seed": "node --loader tsx scripts/seed.ts",
    "db:reset": "node --loader tsx scripts/reset.ts",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.1",
    "@supabase/supabase-js": "^2.49.0",
    "cors": "^2.8.5",
    "dexie": "^4.0.11",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "h3-js": "^4.1.0",
    "mapbox-gl": "^3.12.0",
    "morgan": "^1.10.0",
    "pg": "^8.14.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
